# Copier ce fichier en .env puis renseigner les valeurs (jamais de vraie valeur ici)

# --- Base de données & chiffrement (worker + interface) ---
DATABASE_URL=
ENCRYPTION_KEY=

# --- Sources d'offres (worker) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

# --- Interface web (Auth.js + Google) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Emails autorisés à se connecter, séparés par des virgules
ALLOWED_EMAILS=

# --- Google Sheet des candidatures (compte de service) ---
# En local : chemin du fichier JSON. Sur Vercel : coller le CONTENU du JSON dans GOOGLE_CREDENTIALS_JSON.
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_CREDENTIALS_JSON=
