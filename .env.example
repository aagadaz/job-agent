# Copier ce fichier en .env puis renseigner les valeurs (jamais de vraie valeur ici)

# --- Base de données & chiffrement (worker + interface) ---
DATABASE_URL=
ENCRYPTION_KEY=

# --- Sources d'offres (worker) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Modèles Claude (facultatif) : laisser vide pour les valeurs par défaut
# (claude-haiku-5-5 pour la notation, claude-sonnet-5-5 pour les lettres)
CLAUDE_MODEL=
CLAUDE_LETTER_MODEL=

# --- Interface web (Auth.js + Google) ---
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Nombre maximum de comptes (inscription libre jusqu'à ce plafond)
MAX_USERS=4
# Administrateurs : voient les détails techniques des erreurs
ADMIN_EMAILS=

# --- Google Sheet des candidatures (compte de service) ---
# En local : chemin du fichier JSON. Sur Vercel : coller le CONTENU du JSON dans GOOGLE_CREDENTIALS_JSON.
GOOGLE_CREDENTIALS_PATH=./credentials.json
GOOGLE_CREDENTIALS_JSON=

# --- Bouton « Lancer une recherche » (interface → GitHub Actions) ---
# Jeton GitHub fine-grained : dépôt job-agent uniquement, permission Actions = Read and write
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=aagadaz/job-agent

# Connexion par lien magique (e-mail envoyé via Gmail)
# SMTP_PASS = « mot de passe d'application » Google (16 caractères), PAS ton mot de passe Gmail
SMTP_USER=
SMTP_PASS=
# URL publique utilisée dans les liens envoyés (facultatif sur Vercel : déduite automatiquement)
APP_URL=

# API France Travail (facultatif) : identifiants obtenus sur francetravail.io (application
# avec l'API « Offres d'emploi v2 »). Sans eux, la source est ignorée.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
